{
  "name": "collaborative-spreadsheet-editor",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @sheet/web dev",
    "build": "pnpm --filter @sheet/web build",
    "start": "pnpm --filter @sheet/web start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "check": "scripts/check-structure.sh",
    "e2e": "pnpm --filter @sheet/web e2e"
  }
}
